# Copy to config/eval.env. Fill EXPERIMENT_NAME or set it when invoking an entry point.
EXPERIMENT_NAME="${EXPERIMENT_NAME:-}"
MODEL_PATH="${MODEL_PATH:-${SCRIPT_DIR}/models/BAGEL-7B-MoT}"
MODEL_NAME="${MODEL_NAME:-bagel}"
OUTPUT_BASE="${OUTPUT_BASE:-${SCRIPT_DIR}/outputs}"
GPU_LIST="${GPU_LIST:-0,1,2,3,4,5,6,7}"

RUN_GENERATION="${RUN_GENERATION:-1}"
RUN_EVAL="${RUN_EVAL:-1}"
THINK_MODE="${THINK_MODE:-0}"
GENEVAL_PROMPT_MODE="${GENEVAL_PROMPT_MODE:-long}"  # short / long / both

# Common T2I settings. Leave BATCH_SIZE unset to use each benchmark's supported default.
NUM_STEPS="${NUM_STEPS:-50}"
CFG_SCALE="${CFG_SCALE:-4.0}"
CFG_NORM="${CFG_NORM:-global}"
TIMESTEP_SHIFT="${TIMESTEP_SHIFT:-3.0}"

# Generation activates bagel; all benchmark evaluations activate geneval.
# Keep API keys outside this file.
