# Conda environments used by the launchers. Defaults are local prefixes under
# DG2 so the tree can move between machines without path edits.
_UMM_CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DG2_ROOT="${DG2_ROOT:-$(cd "${_UMM_CONFIG_DIR}/../../.." && pwd)}"
DG2_CONDA_ROOT="${DG2_CONDA_ROOT:-${DG2_ROOT}/.conda}"

# `conda` command loader (the conda install root's profile.d hook, not an env).
if [[ -z "${CONDA_SH:-}" ]]; then
  if command -v conda >/dev/null 2>&1; then
    CONDA_SH="$(conda info --base)/etc/profile.d/conda.sh"
  else
    CONDA_SH="${HOME}/miniconda3/etc/profile.d/conda.sh"
  fi
fi

# Common evaluator environment. Bagel generation itself uses DG2/.venv.
GEN_ENV="${GEN_ENV:-${DG2_CONDA_ROOT}/common}"

# Per-benchmark evaluation envs (RUN_EVAL stage). Some reuse the generation env.
GENEVAL_EVAL_ENV="${GENEVAL_EVAL_ENV:-${DG2_CONDA_ROOT}/geneval}"
# GenEval2's official Qwen3-VL scorer is supported by the generation env's
# transformers>=4.57 stack, so no extra environment is needed on the shared cluster.
GENEVAL2_EVAL_ENV="${GENEVAL2_EVAL_ENV:-${GEN_ENV}}"
DPGBENCH_EVAL_ENV="${DPGBENCH_EVAL_ENV:-${DG2_CONDA_ROOT}/dpgbench}"
IMGEDIT_EVAL_ENV="${IMGEDIT_EVAL_ENV:-${GEN_ENV}}"
GEDITBENCH_EVAL_ENV="${GEDITBENCH_EVAL_ENV:-${GEN_ENV}}"
LONGTEXTBENCH_EVAL_ENV="${LONGTEXTBENCH_EVAL_ENV:-${DG2_CONDA_ROOT}/oneig}"
CVTG_2K_EVAL_ENV="${CVTG_2K_EVAL_ENV:-${DG2_CONDA_ROOT}/cvtg}"
TIIFBENCH_EVAL_ENV="${TIIFBENCH_EVAL_ENV:-${GEN_ENV}}"
ONEIGBENCH_EVAL_ENV="${ONEIGBENCH_EVAL_ENV:-${DG2_CONDA_ROOT}/oneig}"
# U1.5Bench compliance judge (gemini via tokenhub) — only needs openai + tqdm.
U15BENCH_EVAL_ENV="${U15BENCH_EVAL_ENV:-${GEN_ENV}}"
# Qwen-Image-Bench local Q-Judger (ms-swift>=4.0 + qwen-vl-utils + pandas + openpyxl).
# Default is a clone of swift2 with ms-swift upgraded to >=4.0 (see docs/data_setup.md).
QWENIMAGEBENCH_EVAL_ENV="${QWENIMAGEBENCH_EVAL_ENV:-${DG2_CONDA_ROOT}/qwenimagebench}"
# WISE (gpt-4o judge) + RISE (gpt-4o it2i judge) — API-based, reuse the generation env.
WISEBENCH_EVAL_ENV="${WISEBENCH_EVAL_ENV:-${GEN_ENV}}"
RISE_EVAL_ENV="${RISE_EVAL_ENV:-${GEN_ENV}}"
# BizGenEval VLM checklist judge (gemini-2.5-pro via tokenhub) — only needs tqdm (urllib stdlib).
BIZGENEVAL_EVAL_ENV="${BIZGENEVAL_EVAL_ENV:-${GEN_ENV}}"

# Interpreter for the qualitative vision-model review (needs the `openai` SDK + `requests`).
# Defaults to GEN_ENV; override if that env lacks the SDKs.
QUALITATIVE_ENV="${QUALITATIVE_ENV:-${GEN_ENV}}"

# Helper: activate a conda env tolerating `set -u` (conda hooks read unset vars).
umm_conda_activate() {
  local had_nounset=0
  case $- in *u*) had_nounset=1 ;; esac
  set +u
  conda activate "$1"
  if (( had_nounset != 0 )); then set -u; fi
}
